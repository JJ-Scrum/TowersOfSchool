<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TowersOfSchool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TowersOfSchool"
        mc:Ignorable="d"
        Title="Towers of School"> <!-- Height="450" Width="800" -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="543*"/>
            <ColumnDefinition Width="254*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Hintergrund-Texturen -->
        <Image Source="/02aa0790086f91a.png" Stretch="Fill" Margin="0,0,127,207" Grid.ColumnSpan="2"/>
        <Image Source="/02aa0790086f91a.png" Stretch="Fill" Margin="0,217,127,0" Grid.ColumnSpan="2"/>
        <Image Source="/02aa0790086f91a.png" Stretch="Fill" Margin="407,0,0,207" Grid.Column="1" Grid.ColumnSpan="2"/>
        <Image Source="/02aa0790086f91a.png" Stretch="Fill" Margin="407,217,0,0" Grid.Column="1" Grid.ColumnSpan="2"/>
        
        <!-- Baum-Deko -->
        <Image x:Name="tree1" Margin="271,186,184,138" Source="/big_tree_nobg.png" Stretch="Fill" Grid.Column="1"/>
        
        <!-- Pfad-Kacheln mit Texturen -->
        <Image x:Name="path_tile1" Margin="30,105,468,284" Source="/stone_path.png" Stretch="Fill" Height="45" Grid.Column="1"/>
        <Image x:Name="path_tile2" Margin="30,150,468,239" Source="/stone_path.png" Stretch="Fill" Height="45" Grid.Column="1"/>
        <Image x:Name="path_tile3" Margin="30,195,468,194" Source="/stone_path.png" Stretch="Fill" Height="45" Grid.Column="1"/>
        <Image x:Name="path_tile4" Margin="30,240,468,149" Source="/stone_path.png" Stretch="Fill" Height="45" Grid.Column="1"/>
        <Image x:Name="path_tile5" Margin="30,285,468,104" Source="/stone_path.png" Stretch="Fill" Height="45" Grid.Column="1"/>
        
        <!-- Spawn und Destination -->
        <Image x:Name="enemy_spawn" Margin="-11,17,433,320" Source="/cave_entrance.png" Stretch="Fill" Grid.ColumnSpan="2"/>
        <Image x:Name="enemy_dest" Grid.Column="2" Margin="46,17,23,301" Source="/castle_outside.png" Stretch="Fill"/>
        
        <!-- Hauptspielfeld mit Canvas (für Gegner/Türme) -->
        <Canvas x:Name="gameCanvas" Background="Transparent" Grid.Column="1" Grid.Row="0" Panel.ZIndex="10"/>

        <!-- UI Panel: Spieler-Info -->
        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="10,10,10,10" Orientation="Vertical" Background="#FFFFFF" Opacity="0.95"> <!-- Margin="10,360,10,10" -->
            <TextBlock Text="Player Info" FontSize="14" FontWeight="Bold" Foreground="Black" Margin="5"/>
            <TextBlock x:Name="money_display" Text="Money: 200" FontSize="12" Foreground="DarkGreen" Margin="5,2,5,0"/>
            <TextBlock x:Name="castle_health_display" Text="Castle HP: 20" FontSize="12" Foreground="DarkRed" Margin="5,2,5,0"/>
            <TextBlock x:Name="wave_display" Text="Wave: 0" FontSize="12" Foreground="DarkBlue" Margin="5,2,5,0"/>
            <TextBlock x:Name="enemies_display" Text="Enemies: 0" FontSize="12" Foreground="DarkOrange" Margin="5,2,5,0"/>
            <TextBlock x:Name="fps_display" Text="FPS: 60" FontSize="10" Foreground="Gray" Margin="5,2,5,0"/>
            <Button x:Name="tower_buy_btn" Content="Buy Tower (100)" Margin="5,5,5,2" Padding="3"/>
            <TextBlock x:Name="tower_info" Text="Towers: 0" FontSize="10" Foreground="Black" Margin="5,0,5,0"/>
        </StackPanel>
    </Grid>
</Window>