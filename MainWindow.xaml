<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TowersOfSchool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TowersOfSchool"
        mc:Ignorable="d"
        Title="Towers of School"> <!-- Height="450" Width="800" -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="800"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Spielfeld Container mit Canvas -->
        <Canvas x:Name="gameCanvas" Background="#2D5016" Grid.Column="0" Width="800" Height="450">
            
            <!-- Statische Hintergrund-Texturen (mit absoluten Positionen) -->
            <Image Source="/02aa0790086f91a.png" Width="407" Height="207" Canvas.Left="0" Canvas.Top="0" Canvas.ZIndex="0"/>
            <Image Source="/02aa0790086f91a.png" Width="407" Height="233" Canvas.Left="0" Canvas.Top="217" Canvas.ZIndex="0"/>
            <Image Source="/02aa0790086f91a.png" Width="393" Height="207" Canvas.Left="407" Canvas.Top="0" Canvas.ZIndex="0"/>
            <Image Source="/02aa0790086f91a.png" Width="393" Height="233" Canvas.Left="407" Canvas.Top="217" Canvas.ZIndex="0"/>
            
            <!-- Baum-Deko -->
            <Image x:Name="tree1" Source="/big_tree_nobg.png" Width="250" Height="170" Canvas.Left="271" Canvas.Top="140" Canvas.ZIndex="1"/>
            
            <!-- Pfad-Kacheln (nur für Design-Ansicht, werden im Code nacherstellbar) -->
            <Image x:Name="path_tile_static_1" Source="/stone_path.png" Width="45" Height="45" Canvas.Left="30" Canvas.Top="105" Canvas.ZIndex="1" Opacity="0.8"/>
            <Image x:Name="path_tile_static_2" Source="/stone_path.png" Width="45" Height="45" Canvas.Left="30" Canvas.Top="150" Canvas.ZIndex="1" Opacity="0.8"/>
            <Image x:Name="path_tile_static_3" Source="/stone_path.png" Width="45" Height="45" Canvas.Left="30" Canvas.Top="195" Canvas.ZIndex="1" Opacity="0.8"/>
            <Image x:Name="path_tile_static_4" Source="/stone_path.png" Width="45" Height="45" Canvas.Left="30" Canvas.Top="240" Canvas.ZIndex="1" Opacity="0.8"/>
            <Image x:Name="path_tile_static_5" Source="/stone_path.png" Width="45" Height="45" Canvas.Left="30" Canvas.Top="285" Canvas.ZIndex="1" Opacity="0.8"/>
            
            <!-- Spawn und Destination (statisch in XAML für Design) -->
            <Image x:Name="enemy_spawn_img" Source="/cave_entrance.png" Width="60" Height="80" Canvas.Left="35" Canvas.Top="90" Canvas.ZIndex="1"/>
            <Image x:Name="enemy_dest_img" Source="/castle_outside.png" Width="70" Height="85" Canvas.Left="730" Canvas.Top="80" Canvas.ZIndex="1"/>
            
        </Canvas>

        <!-- UI Panel: Spieler-Info -->
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,10,10,10" Orientation="Vertical" Background="#FFFFFF" Opacity="0.95">
            <TextBlock Text="Player Info" FontSize="14" FontWeight="Bold" Foreground="Black" Margin="5"/>
            <TextBlock x:Name="money_display" Text="Money: 200" FontSize="12" Foreground="DarkGreen" Margin="5,2,5,0"/>
            <TextBlock x:Name="castle_health_display" Text="Castle HP: 20" FontSize="12" Foreground="DarkRed" Margin="5,2,5,0"/>
            <TextBlock x:Name="wave_display" Text="Wave: 0" FontSize="12" Foreground="DarkBlue" Margin="5,2,5,0"/>
            <TextBlock x:Name="enemies_display" Text="Enemies: 0" FontSize="12" Foreground="DarkOrange" Margin="5,2,5,0"/>
            <TextBlock x:Name="fps_display" Text="FPS: 60" FontSize="10" Foreground="Gray" Margin="5,2,5,0"/>
            <Button x:Name="tower_buy_btn" Content="Buy Tower (100)" Margin="5,5,5,2" Padding="3"/>
            <TextBlock x:Name="tower_info" Text="Towers: 0" FontSize="10" Foreground="Black" Margin="5,0,5,0"/>
        </StackPanel>
    </Grid>
</Window>